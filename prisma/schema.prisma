generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExerciseCategory {
  AEROBIC
  ANAEROBIC
  FLEXIBILITY
}

enum ExerciseSource {
  MANUAL
  EXTERNAL
}

enum WorkoutStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum MesocycleStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ProgressPhotoType {
  BEFORE
  AFTER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  exercises      Exercise[]
  workouts       Workout[]
  mesocycles     Mesocycle[]
  progressPhotos ProgressPhoto[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Exercise {
  id               String           @id @default(cuid())
  userId           String
  name             String
  description      String
  category         ExerciseCategory @default(ANAEROBIC)
  imageBlobUrl     String?
  source           ExerciseSource   @default(MANUAL)
  externalSourceId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, category])
}

model Workout {
  id            String        @id @default(cuid())
  userId        String
  mesocycleId   String?
  name          String
  scheduledDate DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  status        WorkoutStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mesocycle        Mesocycle?        @relation(fields: [mesocycleId], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, scheduledDate])
  @@index([mesocycleId])
}

model WorkoutExercise {
  id                String   @id @default(cuid())
  workoutId         String
  exerciseId        String
  order             Int
  targetSets        Int?
  targetRepetitions Int?
  targetWeight      Decimal? @db.Decimal(6, 2)
  notes             String?

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@unique([workoutId, order])
  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String   @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  repetitions       Int?
  weight            Decimal? @db.Decimal(6, 2)
  completed         Boolean  @default(false)
  notes             String?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutExerciseId, setNumber])
  @@index([workoutExerciseId])
}

model Mesocycle {
  id                  String          @id @default(cuid())
  userId              String
  name                String
  plannedWorkoutCount Int
  startDate           DateTime?
  endDate             DateTime?
  status              MesocycleStatus @default(PLANNED)
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts       Workout[]
  progressPhotos ProgressPhoto[]

  @@index([userId])
  @@index([userId, status])
}

model ProgressPhoto {
  id          String            @id @default(cuid())
  userId      String
  mesocycleId String
  type        ProgressPhotoType
  blobUrl     String
  blobPath    String?
  mimeType    String?
  sizeBytes   Int?
  takenAt     DateTime?
  createdAt   DateTime          @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mesocycle Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mesocycleId])
  @@index([userId, type])
}
